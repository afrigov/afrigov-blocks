{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "category": "afrigov",
  "textdomain": "afrigov-blocks",
  "editorScript": "file:./index.js",
  "render": "file:./render.php",
  "name": "afrigov/events",
  "title": "Events",
  "icon": "calendar-alt",
  "description": "Upcoming and past events, each with a date block people see at a glance.",
  "keywords": [
    "calendar",
    "dates",
    "meetings"
  ],
  "supports": {
    "html": false
  },
  "attributes": {
    "headingLevel": {
      "type": "number",
      "default": 3
    }
  },
  "providesContext": {
    "afrigov/eventHeading": "headingLevel"
  }
}
