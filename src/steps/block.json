{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "category": "afrigov",
  "textdomain": "afrigov-blocks",
  "editorScript": "file:./index.js",
  "render": "file:./render.php",
  "name": "afrigov/steps",
  "title": "Steps",
  "icon": "editor-ol",
  "description": "What happens, in order: numbered steps, each with a short title and a sentence.",
  "keywords": [
    "process",
    "how it works",
    "numbered"
  ],
  "supports": {
    "html": false
  },
  "attributes": {
    "headingLevel": {
      "type": "number",
      "default": 3
    }
  },
  "providesContext": {
    "afrigov/stepHeading": "headingLevel"
  }
}
