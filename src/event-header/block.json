{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "category": "afrigov",
  "textdomain": "afrigov-blocks",
  "editorScript": "file:./index.js",
  "render": "file:./render.php",
  "name": "afrigov/event-header",
  "title": "Event header",
  "icon": "calendar-alt",
  "description": "The top of an event's page: the large date block, the title and a sentence about it.",
  "keywords": [
    "event",
    "date",
    "title"
  ],
  "supports": {
    "html": false,
    "multiple": false,
    "reusable": false
  },
  "attributes": {
    "title": {
      "type": "string",
      "default": ""
    },
    "lead": {
      "type": "string",
      "default": ""
    },
    "date": {
      "type": "string",
      "default": ""
    },
    "time": {
      "type": "string",
      "default": ""
    },
    "tbc": {
      "type": "boolean",
      "default": false
    }
  }
}
