{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "category": "afrigov",
  "textdomain": "afrigov-blocks",
  "editorScript": "file:./index.js",
  "render": "file:./render.php",
  "name": "afrigov/band",
  "title": "Band",
  "icon": "align-full-width",
  "description": "A section across the page in a colour, holding headings, text and other blocks.",
  "keywords": [
    "section",
    "background",
    "colour",
    "container"
  ],
  "supports": {
    "html": false,
    "align": [
      "full"
    ]
  },
  "attributes": {
    "align": {
      "type": "string",
      "default": "full"
    },
    "colour": {
      "type": "string",
      "enum": [
        "tint",
        "primary",
        "dark",
        "accent"
      ],
      "default": "tint"
    }
  }
}
