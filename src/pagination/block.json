{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "category": "afrigov",
  "textdomain": "afrigov-blocks",
  "editorScript": "file:./index.js",
  "render": "file:./render.php",
  "name": "afrigov/pagination",
  "title": "Pagination",
  "icon": "controls-forward",
  "description": "Links to the previous and next page of a long list, such as: Older news.",
  "keywords": [
    "next",
    "previous",
    "older",
    "newer",
    "pages"
  ],
  "supports": {
    "html": false
  },
  "attributes": {
    "prevLabel": {
      "type": "string",
      "default": ""
    },
    "prevUrl": {
      "type": "string",
      "default": ""
    },
    "nextLabel": {
      "type": "string",
      "default": ""
    },
    "nextUrl": {
      "type": "string",
      "default": ""
    }
  }
}
