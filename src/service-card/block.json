{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "afrigov/service-card",
  "title": "Service card",
  "category": "afrigov",
  "icon": "index-card",
  "description": "One card: a title that links somewhere, and a sentence about it.",
  "parent": [
    "afrigov/service-cards"
  ],
  "textdomain": "afrigov-blocks",
  "supports": {
    "html": false,
    "reusable": false
  },
  "usesContext": [
    "afrigov/cardEdge",
    "afrigov/cardHeading",
    "afrigov/cardHorizontal"
  ],
  "attributes": {
    "title": {
      "type": "string",
      "default": ""
    },
    "text": {
      "type": "string",
      "default": ""
    },
    "url": {
      "type": "string",
      "default": ""
    },
    "image": {
      "type": "object"
    },
    "imageKind": {
      "type": "string",
      "enum": [
        "photo",
        "logo"
      ],
      "default": "photo"
    },
    "meta": {
      "type": "string",
      "default": ""
    }
  },
  "editorScript": "file:./index.js",
  "render": "file:./render.php"
}
