{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "category": "afrigov",
  "textdomain": "afrigov-blocks",
  "editorScript": "file:./index.js",
  "render": "file:./render.php",
  "name": "afrigov/page-title",
  "title": "Page title",
  "icon": "heading",
  "description": "The page's title with a small line above it, such as Press release or Program, and a sentence under it. Used instead of the theme's own title.",
  "keywords": [
    "title",
    "heading",
    "kicker",
    "h1"
  ],
  "supports": {
    "html": false,
    "multiple": false,
    "reusable": false
  },
  "attributes": {
    "caption": {
      "type": "string",
      "default": ""
    },
    "title": {
      "type": "string",
      "default": ""
    },
    "lead": {
      "type": "string",
      "default": ""
    }
  }
}
